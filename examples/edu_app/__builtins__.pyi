# Type stubs for the Sphero Edu app's built-in Python commands.
#
# Copy this file into a folder of Edu-app programs as `__builtins__.pyi`
# (`sphero-dev stubs <folder>`) so Pyright / Pylance / VS Code stop flagging
# `roll`, `set_speed`, `delay`, ... as undefined. It only affects editors.

from enum import Enum
from typing import Any, Awaitable, Callable, TypedDict

class RGB(TypedDict):
    r: int
    g: int
    b: int

class XY(TypedDict):
    x: float
    y: float

class XYZ(TypedDict):
    x: float
    y: float
    z: float

class PitchRollYaw(TypedDict):
    pitch: float
    roll: float
    yaw: float

Color = RGB | tuple[int, int, int]

class EventType(Enum):
    on_collision = ...
    on_freefall = ...
    on_landing = ...
    on_gyro_max = ...
    on_charging = ...
    on_not_charging = ...
    on_ir_message = ...
    on_color = ...

# Movement
async def roll(heading: int, speed: int, duration: float) -> None: ...
def set_speed(speed: int) -> None: ...
def set_heading(heading: int) -> None: ...
def stop_roll(heading: int | None = None) -> None: ...
async def spin(angle: float, duration: float) -> None: ...
async def raw_motor(left: int, right: int, duration: float) -> None: ...
def set_stabilization(stabilize: bool) -> None: ...
def reset_aim() -> None: ...
def calibrate_compass() -> None: ...
def set_compass_direction(direction: int) -> None: ...

# Lights
def set_main_led(color: Color) -> None: ...
def set_back_led(color_or_brightness: Color | int) -> None: ...
def set_front_led(color: Color) -> None: ...
def get_main_led() -> RGB: ...
async def fade(from_color: Color, to_color: Color, duration: float) -> None: ...
async def strobe(color: Color, period: float, count: int) -> None: ...

# BOLT matrix
def set_matrix_pixel(x: int, y: int, color: Color) -> None: ...
def set_matrix_line(x1: int, y1: int, x2: int, y2: int, color: Color) -> None: ...
def set_matrix_fill(x1: int, y1: int, x2: int, y2: int, color: Color) -> None: ...
def set_matrix_character(character: str, color: Color) -> None: ...
def set_matrix_rotation(rotation: int) -> None: ...
def clear_matrix() -> None: ...
async def scroll_matrix_text(text: str, color: Color, fps: int = ..., wait: bool = ...) -> None: ...

# Sensors (may be None for the first moments of a program)
def get_acceleration() -> XYZ | None: ...
def get_vertical_acceleration() -> float | None: ...
def get_orientation() -> PitchRollYaw | None: ...
def get_gyroscope() -> PitchRollYaw | None: ...
def get_velocity() -> XY | None: ...
def get_location() -> XY | None: ...
def get_distance() -> float | None: ...
def get_speed() -> int: ...
def get_heading() -> int: ...
def get_luminosity() -> float | None: ...
def get_compass_direction() -> float | None: ...

# BOLT infrared
def start_ir_broadcast(near: int, far: int) -> None: ...
def stop_ir_broadcast() -> None: ...
def start_ir_follow(near: int, far: int) -> None: ...
def stop_ir_follow() -> None: ...
def start_ir_evade(near: int, far: int) -> None: ...
def stop_ir_evade() -> None: ...
def send_ir_message(channel: int, intensity: int) -> None: ...

# Program control
async def delay(seconds: float) -> None: ...
async def speak(text: str, wait: bool = ...) -> None: ...
def register_event(event_type: EventType, handler: Callable[..., Awaitable[Any] | Any]) -> None: ...
def exit_program() -> None: ...
