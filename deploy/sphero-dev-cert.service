# systemd --user unit: renew sphero.clegg.dev's certificate when it's due.
# Install: see ios/README.md ("HTTPS with a real certificate").
[Unit]
Description=Renew the sphero.clegg.dev certificate
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/repos/sphero-dev/deploy/cert.sh
